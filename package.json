{
  "name": "awesome-markdown-catalog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs && node scripts/generate.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "example": "node examples/compatibility/run.mjs",
    "links": "node scripts/check-links.mjs",
    "verify": "npm run check && npm test && npm run lint"
  },
  "devDependencies": {
    "awesome-lint": "2.3.0",
    "markdown-it": "15.0.1",
    "marked": "18.0.12"
  }
}
